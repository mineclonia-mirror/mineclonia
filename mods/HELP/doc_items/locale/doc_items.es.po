msgstr "Caminar sobre este bloque es completamente silencioso."

#: mods/HELP/doc_items/init.lua:688
msgid "Mining this block is completely silent."
msgstr "Minar este bloque es completamente silencioso."

#: mods/HELP/doc_items/init.lua:691
