#: mods/HELP/doc_items/init.lua:633
msgid "The fall damage on this block is increased by @1%."
msgstr "Obrażenia od upadku na tym bloku są zwiększone o @1%."

#: mods/HELP/doc_items/init.lua:635
msgid "This block negates all fall damage."
msgstr "Ten blok neguje wszystkie obrażenia od upadku."

#: mods/HELP/doc_items/init.lua:637
msgid "The fall damage on this block is reduced by @1%."
msgstr "Obrażenia od upadku na tym bloku są zmniejszone o @1%."

#: mods/HELP/doc_items/init.lua:647
msgid "You can not jump while standing on this block."
msgstr "Nie możesz skakać gdy stoisz na tym bloku."

#: mods/HELP/doc_items/init.lua:650
msgid "This block can be climbed."
msgstr "Na ten blok można się wspiąć."

#: mods/HELP/doc_items/init.lua:654
