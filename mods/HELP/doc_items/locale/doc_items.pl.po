msgstr "Ten blok przepuszcza światło z niewielką stratą jasności."

#: mods/HELP/doc_items/init.lua:750
msgid "This block allows sunlight to propagate without loss in brightness."
msgstr "Ten blok przepuszcza światło słoneczne bez straty jasności."

