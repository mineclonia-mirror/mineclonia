#: mods/HELP/doc_items/init.lua:307
msgid "This block can be mined by any mining tool in half a second."
msgstr ""
"Ten blok może być wykopany przez dowolne narzędzie do kopania w pół sekundy."

#: mods/HELP/doc_items/init.lua:309
msgid "This block can be mined by any mining tool immediately."
msgstr ""
"Ten blok może być wykopany przez dowolne narzędzie do kopania natychmiastowo."

#: mods/HELP/doc_items/init.lua:312
msgid "This block can not be mined by ordinary mining tools."
msgstr "Ten blok nie może być wykopany przez typowe narzędzia do kopania."

#: mods/HELP/doc_items/init.lua:316
msgid "This block can be destroyed by any mining tool in half a second."
msgstr ""
"Ten blok może być zniszczony przez dowolne narzędzie do kopania w pół "
"sekundy."

#: mods/HELP/doc_items/init.lua:318
