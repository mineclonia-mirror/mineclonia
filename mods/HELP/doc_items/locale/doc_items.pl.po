msgid ""
"Item reference of items which are neither blocks, tools or weapons (esp. "
"crafting items)"
msgstr ""
"Informacje na temat wszystkich rzeczy, które nie są blokami, narzędziami i "
"broniami (głównie materiały do wytwarzania)"

#: mods/HELP/doc_items/init.lua:1128
msgid "Mobs"
msgstr "Moby"

#: mods/HELP/doc_items/init.lua:1129
msgid "Different Mobs"
