#: mods/ITEMS/mcl_raw_ores/init.lua:33
msgid "Raw Iron"
msgstr "Необработанное железо"

#: mods/ITEMS/mcl_raw_ores/init.lua:33
msgid "Block of Raw Iron"
msgstr "Блок необработанного железа"

#: mods/ITEMS/mcl_raw_ores/init.lua:33
msgid "Raw Iron. Mine an Iron ore to get it."
msgstr "Необработанное железо. Добывайте железную руду, чтобы получить его."

#: mods/ITEMS/mcl_raw_ores/init.lua:34
msgid ""
"A block of raw Iron is mostly a decorative block but also useful as a "
"compact storage of raw Iron."
msgstr ""
"Блок необработанного железа — это в основном декоративный блок, но также "
"полезен как компактное хранилище необработанного железа."

#: mods/ITEMS/mcl_raw_ores/init.lua:35
msgid "Raw Gold"
msgstr "Необработанное золото"

#: mods/ITEMS/mcl_raw_ores/init.lua:35
msgid "Block of Raw Gold"
msgstr "Блок необработанного золота"

#: mods/ITEMS/mcl_raw_ores/init.lua:35
msgid "Raw Gold. Mine a Gold ore to get it."
msgstr "Необработанное золото. Чтобы получить золото, добывайте золотую руду."

#: mods/ITEMS/mcl_raw_ores/init.lua:36
msgid ""
"A block of raw Gold is mostly a decorative block but also useful as a "
"compact storage of raw Gold."
msgstr ""
"Блок необработанного золота — это в основном декоративный блок, но также "
"полезен в качестве компактного хранилища необработанного золота."
